#!/usr/bin/env nu
# Regenerate the package catalog table in docs/packages.md from the flake.
#
# The table is derived from `nix eval` output, so it can never drift from the
# real package set. CI regenerates and diffs (scripts/catalog + git diff) to
# fail when a package change lands without refreshing the catalog.

const BEGIN = "<!-- catalog:begin (generated by scripts/catalog; do not edit) -->"
const END = "<!-- catalog:end -->"

def main [
  --repo-root: string = "." # Repository root (flake.nix location).
] {
  let root = ($repo_root | path expand)
  let doc = $"($root)/docs/packages.md"
  if not ($doc | path exists) {
    print $"error: ($doc) not found"
    exit 1
  }

  let systems = ["aarch64-darwin" "aarch64-linux" "x86_64-linux"]

  # Per-package metadata from one evaluation. Aliases resolve to the same
  # derivation (same name), so they are folded into one row listing every
  # attribute that points at it.
  let attrs = (
    nix eval --json $"($root | into string)#packages.aarch64-darwin" --apply
      'ps: builtins.mapAttrs (n: p: { name = p.name or null; version = p.version or null; description = p.meta.description or null; homepage = p.meta.homepage or null; }) ps'
    | from json
    | items {|name, meta| { attr: $name, name: $meta.name?, version: $meta.version?, description: $meta.description?, homepage: $meta.homepage? } }
  )

  # Platform availability from the same lists CI builds.
  let availability = (
    $systems
    | each {|sys|
        { sys: $sys, pkgs: (nix eval --json $"($root | into string)#ciPackages.($sys)" | from json) }
      }
  )

  let rows = (
    $attrs
    | group-by name
    | items {|drv, group|
        let attrs_sorted = ($group | get attr | sort)
        let platforms = (
          $availability
          | where {|a| ($group | get attr | any {|attr| $attr in $a.pkgs }) }
          | get sys
          | str join ", "
        )
        {
          attrs: ($attrs_sorted | str join ", ")
          version: ($group | first | get version? | default "")
          platforms: $platforms
          description: ($group | first | get description? | default "")
        }
      }
    | sort-by attrs
  )

  let header = "| Package | Version | Platforms | Description |"
  let sep = "| --- | --- | --- | --- |"
  let body = (
    $rows
    | each {|r|
        $"| ($r.attrs) | ($r.version) | ($r.platforms) | ($r.description) |"
      }
    | str join "\n"
  )
  let table = $"($BEGIN)\n\n($header)\n($sep)\n($body)\n\n($END)"

  let lines = (open $doc --raw | lines)
  let begin_idx = ($lines | enumerate | where item == $BEGIN | get index | first)
  let end_idx = ($lines | enumerate | where item == $END | get index | first)
  if ($begin_idx | is-empty) or ($end_idx | is-empty) {
    print $"error: catalog markers not found in ($doc)"
    exit 1
  }

  let rebuilt = (
    ($lines | take $begin_idx)
    | append ($table | lines)
    | append ($lines | skip ($end_idx + 1))
    | str join "\n"
  )
  $"($rebuilt)\n" | save --force $doc
  print $"catalog updated in ($doc)"
}
